      <property name="styleSheet">
       <string notr="true">QTabWidget::pane {
	border-radius: 4px;
    border: 1px solid #c4c4c4;
	
    top: -1px;
    background: white;
}

QTabWidget::tab-bar {
    left: 5px; /* 移动标签栏到右侧 */
}

/* 未选中的标签样式 */
QTabBar::tab {
    background: #d6e9f8;  /* 浅蓝色背景 */
    border: 1px solid #c4c4c4;
    border-bottom-color: #c4c4c4; /* 与面板边框相同的颜色 */
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 8ex;
    padding: 6px 12px;
    margin-right: 2px;
    color: #333;
}

/* 选中的标签样式 */
QTabBar::tab:selected {
    background: #4a90d9;  /* 深蓝色背景 */
    border-color: #c4c4c4;
    border-bottom-color: white; /* 与面板背景相同的颜色 */
    color: white;
}

/* 悬停时的标签样式 */
QTabBar::tab:hover {
    background: #b3d7ff;  /* 比浅蓝色稍深的悬停色 */
}

/* 未选中的标签下方边框 */
QTabBar::tab:!selected {
    margin-top: 2px; /* 使未选中的标签看起来比选中的低 */
}

/* 禁用标签样式 */
QTabBar::tab:disabled {
    background: #e0e0e0;
    color: #a0a0a0;
}</string>
